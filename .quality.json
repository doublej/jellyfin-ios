{
  "loc": {
    "warn": 300,
    "error": 400
  },
  "dir": {
    "max_files": 6
  },
  "globs": [
    "jellyfin-ios/**/*.swift",
    "Tests/**/*.swift"
  ],
  "i18n": {
    "base": "en",
    "required": [
      "en",
      "nl"
    ],
    "format": "strings",
    "files": [
      "jellyfin-ios/App/Resources/{locale}.lproj/Localizable.strings"
    ]
  }
}
